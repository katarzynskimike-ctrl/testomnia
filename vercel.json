{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "trailingSlash": false,
  "cleanUrls": false,
  "functions": {
    "api/send-report.js": {
      "maxDuration": 10
    },
    "api/compass.js": {
      "maxDuration": 10,
      "includeFiles": "api/_fonts/**"
    },
    "api/admin/data.js": {
      "maxDuration": 10
    },
    "api/checkout.js": {
      "maxDuration": 10
    },
    "api/stripe-webhook.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "testomnia.vercel.app"
        }
      ],
      "destination": "https://www.testomnia.pl/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/compass.png",
      "destination": "/api/compass"
    }
  ]
}